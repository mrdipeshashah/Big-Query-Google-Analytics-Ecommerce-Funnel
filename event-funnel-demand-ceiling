WITH prepped_events AS (
  SELECT
    PARSE_DATE('%Y%m%d', event_date) AS event_date,
    event_name,
    i.item_id,
    i.item_name,
    COALESCE(i.price, 0) AS price,
    COALESCE(i.item_revenue, 0) AS item_revenue,
    (SELECT value.string_value FROM UNNEST(i.item_params) WHERE key = 'stockstatus') AS stock_status
  FROM `mrdipeshashah.analytics_343520795.events_*`,
  UNNEST(items) AS i
  WHERE _TABLE_SUFFIX BETWEEN '20260101' AND '20260831'
    AND event_name IN ('view_item', 'add_to_cart', 'purchase')
)
SELECT
  event_date,
  item_id,
  item_name,
  stock_status,
  price, -- Exposing price so Looker Studio calculated fields work!

  -- Core Funnel Metrics
  COUNTIF(event_name = 'view_item') AS pdp_views,
  COUNTIF(event_name = 'add_to_cart') AS add_to_cart_count,
  COUNTIF(event_name = 'purchase') AS purchase_count,
  
  -- Realized Revenue
  SUM(IF(event_name = 'purchase', item_revenue, 0)) AS realized_revenue,
  
  -- Pre-calculated Out-Of-Stock Loss Metrics (No Looker Studio Calcs Needed for These Two)
  SUM(IF(stock_status = 'outofstock' AND event_name = 'view_item', price, 0)) AS max_unmet_demand_ceiling,
  SUM(IF(stock_status = 'outofstock' AND event_name = 'view_item', price * 0.025, 0)) AS est_lost_revenue_stockouts

FROM prepped_events
GROUP BY 1, 2, 3, 4, 5;
